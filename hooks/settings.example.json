{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["/absolute/path/to/proactive-memory-sidecar/dist/src/bin/hook.js"],
            "timeout": 17
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["/absolute/path/to/proactive-memory-sidecar/dist/src/bin/hook.js"],
            "timeout": 17
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["/absolute/path/to/proactive-memory-sidecar/dist/src/bin/hook.js"],
            "timeout": 17
          }
        ]
      }
    ]
  }
}
